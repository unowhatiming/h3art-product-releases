; Native Godot project, no browser runtime.
config_version=5

[application]
config/name="烛之影：熄灯之后"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")
config/description="第一人称烛光调查游戏"

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1440
window/size/window_height_override=810
window/size/min_width=960
window/size/min_height=540
window/stretch/mode="canvas_items"
window/vsync/vsync_mode=1

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
lights_and_shadows/positional_shadow/atlas_size=4096
anti_aliasing/quality/msaa_3d=2
environment/defaults/default_clear_color=Color(0.02, 0.05, 0.055, 1)

[audio]
driver/enable_input=false
